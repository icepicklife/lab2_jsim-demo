.include "8clocks.jsim"
.include "nominal.jsim"
.include "stdcell.jsim"

*******************************************************************************
* Full adder and 32-bit ripple-carry adder subcircuits below.
*******************************************************************************
.subckt fa a b c_in sum c_out
    Xxor1 a b firsthalfOut xor2
    Xnand1 a b nand_out1 nand2
    Xxor2 firsthalfOut c_in sum xor2
    Xnand2 firsthalfOut c_in nand_out2 nand2
    Xnand3 nand_out1 nand_out2 c_out nand2
.ends

.subckt add32 a[31:0] b[31:0] cin0 sum[31:0] c_out[31:30]
    Xfulladd32 a[31:0] b[31:0] c_out[30:0] cin0 sum[31:0] c_out[31:0] fa
.ends

*******************************************************************************
* Below is the implementation of the as32 subcircuit.
*
* The as32 subcircuit functions as a 32-bit Arithmetic Logic Unit (ALU)
* capable of performing both addition and subtraction, and generating the
* corresponding status flags (negative, overflow, zero).
*
* Its operation is controlled by the single-bit input op0:
* When op0 = 0, the circuit performs addition (A + B).
* When op0 = 1, the circuit performs subtraction (A - B).
*
* The circuit performs both operations with a single 32-bit adder. Instead of 
* using multiplexers to select between B and its inverse, it uses 32 XOR gates.
* For addition (op0=0), b[i] XOR 0 = b[i]. The adder receives b.
* For subtraction (op0=1), b[i] XOR 1 = ~b[i]. The adder receives ~b.
*
* Subtraction is implemented using the two's complement formula: A - B is
* equivalent to A + (~B + 1). The +1 is achieved by feeding the
* op0 signal directly into the adder's initial carry-in (cin0).
*
* The status flags are generated as follows:
* n (negative): A buffer copies the most significant bit (MSB) of the
* result (fas[31]), which represents the sign in two's complement.
* v (overflow): An XOR gate checks if the last two carry bits from the
* adder are different, which indicates a signed overflow has occurred.
* z (zero): A 3-level tree of NOR gates checks if all 32 bits of the
* result are zero.

*******************************************************************************
.subckt as32 a[31:0] b[31:0] op0 fas[31:0] n v z
* Use 32 XOR gates to efficiently select between b (if op0=0) and ~b (if op0=1).
    Xxor_op[31:0] op0#32 b[31:0] b_selected[31:0] xor2
    Xadd32 a[31:0] b_selected[31:0] op0 fas[31:0] cout[31:30] add32
    Xbuf_n fas[31] n buffer
    Xxor_v cout[31] cout[30] v xor2
* 3-level NOR tree to check if fas[31:0] is zero
    Xnorz_l1_0 fas[3:0]   z_l1_0 or4
    Xnorz_l1_1 fas[7:4]   z_l1_1 or4
    Xnorz_l1_2 fas[11:8]  z_l1_2 or4
    Xnorz_l1_3 fas[15:12] z_l1_3 or4
    Xnorz_l1_4 fas[19:16] z_l1_4 or4
    Xnorz_l1_5 fas[23:20] z_l1_5 or4
    Xnorz_l1_6 fas[27:24] z_l1_6 or4
    Xnorz_l1_7 fas[31:28] z_l1_7 or4
    Xnorz_l2_0 z_l1_0 z_l1_1 z_l1_2 z_l1_3 z_l2_0 or4
    Xnorz_l2_1 z_l1_4 z_l1_5 z_l1_6 z_l1_7 z_l2_1 or4
    Xnorz_l3 z_l2_0 z_l2_1 z nor2
.ends

*******************************************************************************
* Below is the implemntation of the cmp32 subcircuit.
*
* The cmp32 subcircuit is a 32-bit comparator that determines the
* relationship between two numbers (A and B) by analyzing the status flags
* (n, v, z) generated by a preceding as32 subcircuit performing A - B.
*
* Its operation is controlled by the 2-bit input op[2:1]:
* When op[2:1] = 01 (op1=1), it checks for equality (A = B).
* When op[2:1] = 10 (op2=1), it checks for less-than (A < B).
* When op[2:1] = 11, it checks for less-than-or-equal-to (A <= B).
*
* The comparison logic is implemented as follows:
* A = B is true if the result of A - B is zero. The circuit
* checks this by seeing if the z flag is 1. This check is enabled by op1.
* A < B for signed numbers is true if the negative flag and
* overflow flag are different (n XOR v). This check is enabled by op2.
*
* An OR gate combines the results of the less than and equal checks.
* This allows the circuit to handle all three conditions (A < B, A = B,
* and A <= B) and output a single true or false bit on fcmp[0]. The
* remaining 31 bits of the fcmp bus are unused and tied to ground.
*
*******************************************************************************
.subckt cmp32 n v z op[2:1] fcmp[31:0]
    Xxor_lt n v n_xor_v xor2
    Xand_lt op2 n_xor_v lt_res and2
    Xand_eq op1 z eq_res and2
    Xor_final lt_res eq_res fcmp[0] or2
    Xgnd_unused[31:1] fcmp[31:1] constant0
.ends

*******************************************************************************
* Instantiation and plot below.
*******************************************************************************

Xas32  a[31:0] b[31:0] op0 fas[31:0] n v z as32
Xcmp32 n v z op[2:1] fcmp[31:0] cmp32

Wa a[31:0] nrz(0, 5, 20n, 0, 1p, 1p)
+ 0x00000000 0x55555555 0x00000000 0x55555555 -1 0x00000000 0x00000000
+ 0xAAAAAAAA 0x00000000 0xAAAAAAAA 1 -1 0x80000000 -1
+ 2 2 2 0x80000000 0x80000000 0x80000000 3 3 3 0x7FFFFFFF 0x7FFFFFFF
+ 0x7FFFFFFF 3 3 3

Wb b[31:0] nrz(0, 5, 20n, 0, 1p, 1p)
+ 0x00000000 0x00000000 0x55555555 0x55555555 -1 0x00000000 -1
+ 0x00000000 0xAAAAAAAA 0xAAAAAAAA -1 1 0x80000000 -1
+ -3 -3 -3 2 2 2 5 5 5 -2 -2
+ -2 3 3 3

Wop op[2:0] nrz(0, 5, 20n, 0, 1p, 1p)
+ 0b000 0b000 0b000 0b000 0b000 0b001 0b001 0b000 0b000 0b000 0b000
+ 0b000 0b000 0b001 0b011 0b101 0b111 0b011 0b101 0b111 0b011 0b101
+ 0b111 0b011 0b101 0b111 0b011 0b101 0b111

.tran 580n

.plot b(op[2:0])
.plot x(a[31:0])
.plot x(b[31:0])

.plot x(fas[31:0])
.plot fcmp[0]

.plot n as negative
.plot v as overflow
.plot z as zero

.end

*******************************************************************************
* Note that we will be using the bit inputs A and B as start node, while the
* end node will be the fcmp[0] since it's the end output of the chained circuit
* following the diagram.
*
* Proceeding with the diagram, one could note that all possible paths will go 
* under the as32 and comparator blocks, yet a difference of levels could be seen
* amongst the implementation of n, v, and z.
*
* Hence, we note that the check zero operation (z) is comprised of the chained
* 32 OR operations to check if each of the bits is zero. Using the nor-gate 
* implementation, it's comprised of 3 levels of gates being chained together 
* to accommodate the incapacity of a single gate to render 32 inputs
*
* Therefore, we could say that the zero operation path could be the longest since
* it has the chained or-gates alongside the as32 and cmp32 gate operations
* 
* The path in detail shows as follows:
*
* A,B -> xor_bitwiseOp -> 32-bit adder -> 3-level nor tree (zero operation)
*   -> Xand_eq (cmp32) -> Xor_final (cmp32) -> fcmp[0]
*
* This is assuming that the gates used have a fixed delay value
*******************************************************************************