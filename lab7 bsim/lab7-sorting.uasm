|
| 2. In-Place Array Sorting
|
|||||||||||||||||||||||||||||||||||||||||||||||||||||||||||||||||||||||||||||||

.include beta.uasm

        LD(r31, INPUT, r0)  | r0 is used for the array length

LOOP:   ADDC(r1, 4, r1)      | r1 is used for the address of arr[i]
        ADDC(r2, 8, r2)      | r2 is used for the address of arr[i + 1]
        LD(r1, INPUT, r3)
        LD(r2, INPUT, r4)
        CMPLT()







. = 0x19C

INPUT: 
        LONG(7)
        LONG(5)
        LONG(7)
        LONG(8)
        LONG(6)
        LONG(4)
        LONG(9)
        LONG(3)
