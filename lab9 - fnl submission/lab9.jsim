.include "8clocks.jsim"
.include "nominal.jsim"
.include "stdcell.jsim"

*******************************************************************************
* Helper Subcircuits
* - reg32 - insert description
*******************************************************************************

* 32-bit Register (used for the PC)
.subckt reg32 clk din[31:0] q[31:0]
    Xdreg[31:0] clk din[31:0] q[31:0] dreg
.ends

* Fanout helper (used for Sign Extension of C)
.subckt fanout16 in out[15:0]
    Xbuf in out[15:0] buffer
.ends

* Full adder and 32-bit ripple-carry adder subcircuits
*******************************************************************************
.subckt fa a b c_in sum c_out
    Xxor1 a b firsthalfOut xor2
    Xnand1 a b nand_out1 nand2
    Xxor2 firsthalfOut c_in sum xor2
    Xnand2 firsthalfOut c_in nand_out2 nand2
    Xnand3 nand_out1 nand_out2 c_out nand2
.ends

.subckt add32 a[31:0] b[31:0] cin0 sum[31:0] c_out[31:30]
    Xfulladd32 a[31:0] b[31:0] c_out[30:0] cin0 sum[31:0] c_out[31:0] fa
.ends

*******************************************************************************
* as32 and cmp32 subcircuits MAY MALI PA SA CMP32 FIX ERROR!!!!!!!
*******************************************************************************
.subckt as32 a[31:0] b[31:0] op0 fas[31:0] n v z
* Use 32 XOR gates to efficiently select between b (if op0=0) and ~b (if op0=1).
    Xxor_op[31:0] op0#32 b[31:0] b_selected[31:0] xor2
    Xadd32 a[31:0] b_selected[31:0] op0 fas[31:0] cout[31:30] add32
    Xbuf_n fas[31] n buffer
    Xxor_v cout[31] cout[30] v xor2
* 3-level NOR tree to check if fas[31:0] is zero
    Xnorz_l1_0 fas[3:0]   z_l1_0 or4
    Xnorz_l1_1 fas[7:4]   z_l1_1 or4
    Xnorz_l1_2 fas[11:8]  z_l1_2 or4
    Xnorz_l1_3 fas[15:12] z_l1_3 or4
    Xnorz_l1_4 fas[19:16] z_l1_4 or4
    Xnorz_l1_5 fas[23:20] z_l1_5 or4
    Xnorz_l1_6 fas[27:24] z_l1_6 or4
    Xnorz_l1_7 fas[31:28] z_l1_7 or4
    Xnorz_l2_0 z_l1_0 z_l1_1 z_l1_2 z_l1_3 z_l2_0 or4
    Xnorz_l2_1 z_l1_4 z_l1_5 z_l1_6 z_l1_7 z_l2_1 or4
    Xnorz_l3 z_l2_0 z_l2_1 z nor2
.ends

.subckt cmp32 n v z op[2:1] fcmp[31:0]
    Xxor_lt n v n_xor_v xor2
    Xand_lt op2 n_xor_v lt_res and2
    Xand_eq op1 z eq_res and2
    Xor_final lt_res eq_res fcmp[0] or2
    Xgnd_unused[31:1] fcmp[31:1] constant0
.ends

*******************************************************************************
* bool32 and shift 32 subcircuits
*******************************************************************************
.subckt bool32 a[31:0] b[31:0] op[3:0] fbool[31:0]
    Xbool[31:0] a[31:0] b[31:0] op0#32 op1#32 op2#32 op3#32 fbool[31:0] mux4
.ends

.subckt shift32 a[31:0] b[4:0] op[1:0] fshift[31:0]
    * Sets the shift type (Logical or Arithmetic) based on op1.
    Xstype op1 0 a31 stype_out mux2

    * Reverses the bits if left shift (op0 = 0)
    Xreverse[31:0] op0#32 a[0:31] a[31:0] reverse_out[31:0] mux2

    * 5-Stage Right Shift Barrel Shifter
    Xshiftr1[31:0] b0#32 reverse_out[31:0] stype_out reverse_out[31:1] shiftr1_out[31:0] mux2
    Xshiftr2[31:0] b1#32 shiftr1_out[31:0] stype_out#2 shiftr1_out[31:2] shiftr2_out[31:0] mux2
    Xshiftr4[31:0] b2#32 shiftr2_out[31:0] stype_out#4 shiftr2_out[31:4] shiftr4_out[31:0] mux2
    Xshiftr8[31:0] b3#32 shiftr4_out[31:0] stype_out#8 shiftr4_out[31:8] shiftr8_out[31:0] mux2
    Xshiftr16[31:0] b4#32 shiftr8_out[31:0] stype_out#16 shiftr8_out[31:16] shiftr16_out[31:0] mux2

    Xreverse2[31:0] op0#32 shiftr16_out[0:31] shiftr16_out[31:0] fshift[31:0] mux2
.ends

*******************************************************************************
* alu32 subcircuit
*******************************************************************************

.subckt alu32 a[31:0] b[31:0] alufn[5:0] f[31:0] z
    Xas32 a[31:0] b[31:0] alufn0 fas[31:0] n v z as32
    Xbool32 a[31:0] b[31:0] alufn[3:0] fbool[31:0] bool32
    Xshift32 a[31:0] b[4:0] alufn[1:0] fshift[31:0] shift32
    Xcmp32 n v z alufn[2:1] fcmp[31:0] cmp32

    Xalufn[31:0] alufn4#32 alufn5#32 fas[31:0] fbool[31:0] fshift[31:0] fcmp[31:0] f[31:0] mux4
.ends

Xmemory  vdd  0    0   pc[8:2]    inst[31:0]
+        vdd  0    0   mema[8:2]  memrd[31:0]
+        0    clk  wr  mema[8:2]  memwd[31:0]
