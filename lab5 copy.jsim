.include "8clocks.jsim"
.include "nominal.jsim"
.include "stdcell.jsim"

*******************************************************************************
* Full adder and 32-bit ripple-carry adder subcircuits below.
*******************************************************************************
.subckt fa a b c_in sum c_out

    Xxor1 a b firsthalfOut xor2    
    Xnand1 a b nand_out1 nand2
    Xxor2 firsthalfOut c_in sum xor2           
    Xnand2 firsthalfOut c_in nand_out2 nand2
    Xnand3 nand_out1 nand_out2 c_out nand2

.ends

.subckt add32 a[31:0] b[31:0] cin0 sum[31:0] c_out[31:30]

    Xfulladd32 a[31:0] b[31:0] c_out[30:0] cin0 sum[31:0] c_out[31:0] fa

.ends

*******************************************************************************
* Counter32 subcircuit below with reference to the logic diagram in Slide 7
* or the version 2 of 32-bit counter.
*
* This circuit is constructed from three primary components arranged in a
* feedback loop: a 32-bit adder (add32), 32 multiplexers (mux2), and a
* 32-bit register (dreg). 

* The register's current output (f) is sent back to the adder's input. 
* The adder computes the next value, which is then selected by the 
* multiplexer (based on the reset signal) and becomes the new input for 
* the register. The register only updates its value on the rising edge of the 
* clock (clk).
*
*
* Other:
* The # symbol is JSim's duplication iterator which was used to create
* multiple copies of a single node. In this circuit, the single-bit reset
* and clk signals must be connected to all 32 instances of the multiplexers
* and registers. The reset#32 and clk#32 creates the necessary
* 32 connections. Similarly, 0#32 provides 32 individual ground connections for 
* the multiplexers' inputs.
*******************************************************************************
.subckt counter32 reset a[31:0] f[31:0] clk

  Xadder a[31:0] f[31:0] 0 adder_sum[31:0] overflow_out[31:30] add32

  Xmux[31:0] reset#32 adder_sum[31:0] 0#32 mux_out[31:0] mux2

  Xreg[31:0] mux_out[31:0] clk#32 f[31:0] dreg

.ends

*******************************************************************************
* For zero flag of as32, we define the nor-chain checker as zerodetect32
*******************************************************************************
.subckt zerodetect32 in[31:0] z

  Xnor0 in[3:0] nor_out0 nor4
  Xnor1 in[7:4] nor_out1 nor4
  Xnor2 in[11:8] nor_out2 nor4
  Xnor3 in[15:12] nor_out3 nor4
  Xnor4 in[19:16] nor_out4 nor4
  Xnor5 in[23:20] nor_out5 nor4
  Xnor6 in[27:24] nor_out6 nor4
  Xnor7 in[31:28] nor_out7 nor4

  Xnor8 nor_out[3:0] nor_outA nor4
  Xnor9 nor_out[7:4] nor_outB nor4

  Xnor10 nor_outA nor_outB 0 0 z nor4
.ends
*******************************************************************************
* Defining as32
*******************************************************************************

.subckt as32 a[31:0] b[31:0] op0 fas[31:0] n v z

  Xb_invert[31:0] op0 b[31:0] b_inv[31:0] xor2

  Xadder a[31:0] b_inv[31:0] op0 fas[31:0] carry_out[31:30] add32

  .connect fas31 n

  .connect carry_out31 v

  Xzero fas[31:0] z zerodetect32
.ends

*******************************************************************************
* Defining cmp32
*******************************************************************************

.subckt cmp32 n v z op[2:1] fcmp[31:0]
  
  Xxor1 n v n_xor_v xor2

  
  Xor1 z n_xor_v le_cond or2

  Xcmp_mux0 op1 z le_cond cmp_temp mux2
  Xcmp_mux1 op2 n_xor_v cmp_temp cmp_out mux2

  Xreplicate[31:0] cmp_out fcmp[31:0] buffer1

.ends

*******************************************************************************
* Combining via chain diagram
*******************************************************************************

Xaddsub a[31:0] b[31:0] op0 fas[31:0] n v z as32
Xcmp n v z op[2:1] fcmp[31:0] cmp32

*******************************************************************************
* Test Cases
*******************************************************************************

* Waveform generator for the 'a' input bus
Wa a[31:0] nrz(0, 5, 20n, 0, 1p, 1p)
+ 0x00000000 0x55555555 0x00000000 0x55555555 -1 0x00000000 0x00000000
+ 0xAAAAAAAA 0x00000000 0xAAAAAAAA 1 -1 0x80000000 -1
+ 2 2 2 0x80000000 0x80000000 0x80000000 3 3 3 0x7FFFFFFF 0x7FFFFFFF
+ 0x7FFFFFFF 3 3 3

* Waveform generator for the 'b' input bus
Wb b[31:0] nrz(0, 5, 20n, 0, 1p, 1p)
+ 0x00000000 0x00000000 0x55555555 0x55555555 -1 0x00000000 -1
+ 0x00000000 0xAAAAAAAA 0xAAAAAAAA -1 1 0x80000000 -1
+ -3 -3 -3 2 2 2 5 5 5 -2 -2
+ -2 3 3 3

* Waveform generator for the 'op' control bus (3 bits)
Wop op[2:0] nrz(0, 5, 20n, 0, 1p, 1p)
+ 0b000 0b000 0b000 0b000 0b000 0b001 0b001 0b000 0b000 0b000 0b000
+ 0b000 0b000 0b001 0b011 0b101 0b111 0b011 0b101 0b111 0b011 0b101
+ 0b111 0b011 0b101 0b111 0b011 0b101 0b111

* --- Instantiate the circuits to be tested ---
Xas32 a[31:0] b[31:0] op0 fas[31:0] n v z as32
Xcmp32 n v z op[2:1] fcmp[31:0] cmp32

* --- Run the transient simulation ---
* --- Run the transient simulation and plot results individually ---
.tran 580n

.plot reset
.plot x(b[31:0])
.plot x(fas[31:0])
.plot fcmp0
.plot n
.plot v
.plot z
