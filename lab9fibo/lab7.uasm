| Castillo, Hanzo
| Jaso, Elijem
| Marcelino, Jaren
| 
| LAB 7 - Fibonacci Sequence
|
|||||||||||||||||||||||||||||||||||||||||||||||||||||||||||||||||||||||||||||||


.include beta.uasm

        LD(INPUT, r0)           | r0 = input number (n)
        ADDC(r31, 0x318, r3)          | r3 = address of OUTPUT array (0x318)
        LD(fib0, r1)            | r1 = 0
        LD(fib1, r2)            | r2 = 1

        | ---- handle n = 0 ----
        CMPEQ(r0, r31, r13)     | r13 = (n == 0)
        BNE(r13, done)          | if n == 0 → done (no output)

        | ---- store first number ----
        ST(r1, 0, r3)           | OUTPUT[0] = 0

        | ---- handle n = 1 ----
        CMPEQC(r0, 1, r14)      | r14 = (n == 1)
        BNE(r14, done)          | if n == 1 → done after storing 0

        | ---- store second number ----
        ST(r2, 4, r3)           | OUTPUT[1] = 1

        | ---- prepare loop ----
        ADDC(r31, 2, r4)        | i = 2

fibo_loop:
        CMPLE(r0, r4, r10)      | while (i < n)
        BNE(r10, done)

        ADD(r2, r1, r5)         | r5 = r1 + r2

        MULC(r4, 4, r7)         | offset = i * 4
        ADD(r3, r7, r8)         | r8 = OUTPUT + offset
        ST(r5, 0, r8)           | OUTPUT[i] = r5

        ADDC(r2, 0, r1)         | r1 = old r2
        ADDC(r5, 0, r2)         | r2 = new number
        ADDC(r4, 1, r4)         | i++
        BR(fibo_loop)

done:
        HALT()


. = 0x300
fib0: LONG(0)
fib1: LONG(1)

. = 0x310
INPUT: LONG(12)

. = 0x318
OUTPUT:
