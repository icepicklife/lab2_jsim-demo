.include beta.uasm

|| This is a test file for Lab 9 that simulates all of the operations in the Beta processor. 
|| While this file will test if you have covered all of your opcodes
|| and their ccorrect signals, use the Lab 7 codes to actually test if your Lab 9 
|| actually works. Good luck! ~Ros

||  LOAD
LD(R31, input, R0)

||  ARITHMETIC
ADD(R0,R1,R2)
ADDC(R0,5,R3)
SUB(R0,R3,R4)
SUBC(R0,1,R5)

||  LOGICAL
AND(R0,R0,R6)
ANDC(R0,3,R6)
OR(R0,R4,R7)
ORC(R0,-1,R7)
XOR(R0, R0, R8)
XORC(R0,1,R8)

||  SHIFTING
SHL(R0,R0,R9)
SHR(R0,R0,R9)
SHR(R0,R0,R9)
SHLC(R0,1,R10)
SHRC(R0,1,R10)
SRAC(R0,1,R10)

||  COMPARISON
CMPLT(R0, R2,R11) 
CMPLE(R0,R2,R12)
CMPEQ(R0,R31,R13)
CMPLTC(R0,2,R11)
CMPLEC(R0,2,R11)
CMPEQC(R0,2,R11)

||  BRANCHING
BNE(R0,decrement)
MULC(R0,4,R12)
|| decrementer
decrement:
BEQ(R0,done)
SUBC(R0,1,R0)

|||  OPTIONAL JUMP - The next two lines of code is a very scuffed loop of the decrementer using the JUMP instruction. 
|||  If you want to test out if your JMP works, uncomment the next two lines of code.
|||  WARNING: If you do uncomment the next 2 lines, given the nature of JMP, the program will do ONE MORE run of the entire program
|||  from start to finish. 

ADDC(R31,0x64,R26) 
JMP(R26,R31)

BR(decrement)

done: || STORE
ST(R3,output,R31)
HALT()



.=0x200
input: LONG(2)
output: