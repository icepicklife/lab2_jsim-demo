| Castillo, Hanzo
| Jaso, Elijem
| Marcelino, Jaren
|
| LAB 7 - In-Place Array Sorting
|
|||||||||||||||||||||||||||||||||||||||||||||||||||||||||||||||||||||||||||||||

.include beta.uasm

                LD(INPUT, r0)           | r0 = N
                SUBC(r0, 1, r1)         | r1 = N - 1 (upper bound of outer loop)

outer_loop:     CMPLEC(r1, 0, r10)      | checks if outer loop count becomes less than 0
                BT(r10, done)

                ADDC(r31, 0, r2)        | initialize inner loop index, i

inner_loop:     SUB(r0, r2, r3)         | r3 = N - i
                SUBC(r3, 1, r3)         | r3 = N - i - 1 (sets the upper bound of inner loop)
                CMPLEC(r3, 0, r10)      | checks if end of inner loop has been reached
                BT(r10, inner_end)      | goes to branch inner_end if true

                MULC(r2, 4, r4)         | we obtain the address of i by multiplying r2 * 4 since the addresses are incremented by 4 bytes
                ADDC(r4, INPUT + 4, r4) | +4 since the first number of the array is the array length

                LD(r4, 0, r5)           | gets the first number
                LD(r4, 4, r6)           | gets the second number

                CMPLE(r5, r6, r7)       | checks if the first number is less than the second number
                BT(r7, no_swap)         | goes to branch no_swap if true

                ST(r6, 0, r4)           | swaps the two numbers since the first number is greater
                ST(r5, 4, r4)

no_swap:        ADDC(r2, 1, r2)         | increments i
                BR(inner_loop)          | returns to inner_loop

inner_end:      SUBC(r1, 1, r1)         | decrements upper bound of outer loop
                BR(outer_loop)          | returns to outer_loop

done:           HALT()

. = 0x19C

INPUT: 
        LONG(7)
        LONG(5)
        LONG(7)
        LONG(8)
        LONG(6)
        LONG(4)
        LONG(9)
        LONG(3)

OUTPUT:
